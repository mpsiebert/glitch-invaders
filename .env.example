# ==============================================================
# Glitch Invaders — Environment Configuration
# ==============================================================

# ─── Sentry Integration (omit ALL for local demo mode) ────────
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=

# ─── Station Identity ─────────────────────────────────────────
VITE_STATION_ID=arcade-01
VITE_SENTRY_ENVIRONMENT=production

# ─── Build-time only (NEVER shipped to browser) ──────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Inactivity Timeout (ms, default 180000 = 3 min) ─────────
VITE_INACTIVITY_TIMEOUT_MS=180000

# ─── Fallback Prepared Incident URLs (optional) ──────────────
# Use these when live Sentry events are slow to ingest.
# Run through the game once, then copy the issue URLs here.
VITE_FALLBACK_BOUNTY1_URL=
VITE_FALLBACK_BOUNTY2_URL=
VITE_FALLBACK_BOUNTY3_URL=
